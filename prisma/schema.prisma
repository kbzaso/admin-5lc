generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                   String                @id @unique
  name                 String
  stock                Int?
  date                 DateTime?             @db.Timestamptz(6)
  Payment              Payment[]
  CancellationCampaign CancellationCampaign?
  FeedbackCampaign     FeedbackCampaign?
}

model Payment {
  id                 String    @id @unique
  rut                String?
  price              Float
  ticketAmount       Int
  date               DateTime  @default(now())
  signature_token    String?
  payment_status     String?
  payment_token      String?
  customer_email     String
  customer_name      String
  customer_phone     String?
  productId          String
  buys               Json
  payment_id_service String?   @unique
  ticketsType        String
  discount_code      String?
  client_id          String?
  ticketValidated    Int       @default(0)
  changeEvent        Boolean   @default(false)
  refund             Boolean   @default(false)
  orderId            String?
  paidAt             DateTime?
  Comment            Comment[]
  Order              Order?    @relation(fields: [orderId], references: [id])
  Product            Product   @relation(fields: [productId], references: [id])
  EmailLog           EmailLog[]
  PaymentChangeLog   PaymentChangeLog[]
  CancellationResponse CancellationResponse[]
  FeedbackResponse     FeedbackResponse[]

  @@index([orderId, payment_status, paidAt])
}

model Comment {
  id          String   @id @unique
  paymentId   String
  commentText String
  createdAt   DateTime @default(now())
  userId      String
  Payment     Payment  @relation(fields: [paymentId], references: [id])
  User        Users    @relation(fields: [userId], references: [id])
}

model Users {
  id               String             @id
  name             String
  Comment          Comment[]
  PaymentChangeLog PaymentChangeLog[]
}

model Merch {
  id           String         @id
  name         String
  image        String
  price        Float
  dateAdded    DateTime       @default(now())
  MerchPayment MerchPayment[]
}

model MerchPayment {
  id                 String    @id
  merchId            String
  price              Float
  quantity           Int
  paymentStatus      String?
  payment_id_service String?
  date               DateTime  @default(now())
  orderId            String?
  variationId        String?
  variationLabel     String?
  delivered          Boolean   @default(false)
  deliveryDate       DateTime?
  Merch              Merch     @relation(fields: [merchId], references: [id])
  Order              Order?    @relation(fields: [orderId], references: [id])
}

model Order {
  id             String         @id
  totalAmount    Float
  status         String
  createdAt      DateTime       @default(now())
  customerEmail  String
  customerName   String
  customerPhone  String?
  customerRut    String?
  address        String?
  comuna         String?
  region         String?
  deliveryOption String?
  orderId        String?
  paidAt         DateTime?
  MerchPayment   MerchPayment[]
  Payment        Payment[]
  EmailLog       EmailLog[]

  @@index([status, paidAt])
}

/// One row per confirmation-email send attempt against 5lc-mail-api. Append-only
/// so a failed send followed by a manual resend keeps both attempts on record.
/// Table is owned/migrated from 5lc-sveltkit-sanity/prisma; keep this model in
/// sync with that schema by hand since this repo has no migrations of its own.
model EmailLog {
  id         String   @id @default(uuid())
  emailType  String // "order_confirmation" | "ticket_confirmation"
  status     String // "sent" | "failed"
  providerId String? // Resend message id, set when status = "sent"
  error      String? // error message, set when status = "failed"
  orderId    String?
  paymentId  String?
  createdAt  DateTime @default(now())
  Order      Order?   @relation(fields: [orderId], references: [id])
  Payment    Payment? @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@index([paymentId])
}

/// One row per "Actualizar pago" submission in eventos/[slug] — both plain
/// edits and event transfers. Append-only so history survives further edits
/// or a hard Payment delete (paymentId/userId are SET NULL, and from/to
/// ProductName are snapshotted so the row stays readable even if the Product
/// is renamed later).
/// Table is owned/migrated from 5lc-sveltkit-sanity/prisma; keep this model in
/// sync with that schema by hand since this repo has no migrations of its own.
model PaymentChangeLog {
  id              String   @id @default(uuid())
  paymentId       String?
  changeType      String // "edit" | "transfer"
  fromProductId   String?
  fromProductName String?
  toProductId     String?
  toProductName   String?
  before          Json // snapshot of key Payment fields prior to this update
  after           Json // snapshot of the same fields after this update
  userId          String?
  createdAt       DateTime @default(now())
  Payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  Users           Users?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([fromProductId, createdAt])
  @@index([toProductId, createdAt])
  @@index([paymentId])
}

/// One row per cancelled event for which the admin launched the buyer
/// refund-or-change flow. Owns the eligible replacement list and send state.
/// Table is owned/migrated from 5lc-sveltkit-sanity/prisma; keep this model in
/// sync with that schema by hand since this repo has no migrations of its own.
model CancellationCampaign {
  id               String    @id @default(uuid())
  productId        String    @unique // cancelled event (Sanity _id)
  eligibleEventIds String[] // Product ids buyers may move their ticket to
  status           String    @default("draft") // "draft" | "sent"
  createdByUserId  String? // Clerk user who created/sent it
  createdAt        DateTime  @default(now())
  sentAt           DateTime?
  Product          Product   @relation(fields: [productId], references: [id])
  CancellationResponse CancellationResponse[]
}

/// One row per Payment included in a cancellation campaign, created at send
/// time. Carries the unique link token, the email-send state, the buyer's
/// choice and (refund branch) the bank-transfer details — bank data lives
/// here on purpose, never on Payment.
/// Table is owned/migrated from 5lc-sveltkit-sanity/prisma; keep this model in
/// sync with that schema by hand since this repo has no migrations of its own.
model CancellationResponse {
  id                String    @id @default(uuid())
  campaignId        String
  paymentId         String
  token             String    @unique // the /cancelacion/[token] link
  emailStatus       String    @default("pending") // "pending" | "sent" | "failed"
  choice            String? // null = no response yet | "refund" | "change"
  respondedAt       DateTime?
  // refund branch (Chilean bank transfer, processed manually by the admin)
  bankHolderName    String?
  bankRut           String?
  bankName          String?
  bankAccountType   String? // "corriente" | "vista" | "ahorro" | "cuenta_rut"
  bankAccountNumber String?
  bankEmail         String?
  refundStatus      String? // "pending" | "transferred"
  refundedAt        DateTime?
  refundedByUserId  String?
  // change branch
  targetProductId   String?
  createdAt         DateTime  @default(now())
  CancellationCampaign CancellationCampaign @relation(fields: [campaignId], references: [id])
  Payment              Payment              @relation(fields: [paymentId], references: [id])

  @@unique([campaignId, paymentId]) // idempotent createMany with skipDuplicates
  @@index([choice, refundStatus])
}

/// One row per event for which the admin launched the post-event feedback
/// survey. `questions` snapshots the five question texts exactly as they were
/// sent, so the catalog can be reworded later without changing the meaning of
/// answers already collected (q1 always maps to questions[0] as sent).
/// Table is owned/migrated from 5lc-sveltkit-sanity/prisma; keep this model in
/// sync with that schema by hand since this repo has no migrations of its own.
model FeedbackCampaign {
  id              String             @id @default(uuid())
  productId       String             @unique // surveyed event (Sanity _id)
  questions       Json // the five question texts as sent
  status          String             @default("draft") // "draft" | "sent"
  createdByUserId String? // Clerk user who created/sent it
  createdAt       DateTime           @default(now())
  sentAt          DateTime?
  Product         Product            @relation(fields: [productId], references: [id])
  FeedbackResponse FeedbackResponse[]
}

/// One row per feedback *recipient*, NOT per payment — a multi-ticket buyer
/// can produce several rows (companions answering through the buyer's
/// shareToken today, co-attendee emails collected at checkout later), so
/// paymentId is deliberately non-unique.
///
/// Idempotent re-send relies on @@unique([campaignId, paymentId, recipientEmail])
/// instead: a named recipient can never be created twice (createMany with
/// skipDuplicates), while anonymous companions carry recipientEmail = null and
/// never collide, because Postgres treats NULLs as distinct in unique indexes.
/// Table is owned/migrated from 5lc-sveltkit-sanity/prisma; keep this model in
/// sync with that schema by hand since this repo has no migrations of its own.
model FeedbackResponse {
  id             String           @id @default(uuid())
  campaignId     String
  paymentId      String
  token          String           @unique // the /feedback/[token] link
  /// Buyer rows only: the multi-use link the buyer forwards to the people who
  /// came with them. Companion submissions through it create sibling rows,
  /// capped at the payment's ticketAmount.
  shareToken     String?          @unique
  /// null = anonymous companion who answered via shareToken
  recipientEmail String?
  isBuyer        Boolean          @default(true)
  emailStatus    String           @default("pending") // "pending" | "sent" | "failed" | "not_emailed"
  q1             Int?
  q2             Int?
  q3             Int?
  q4             Int?
  q5             Int?
  comment        String?
  respondedAt    DateTime?
  createdAt      DateTime         @default(now())
  FeedbackCampaign FeedbackCampaign @relation(fields: [campaignId], references: [id])
  Payment          Payment          @relation(fields: [paymentId], references: [id])

  @@unique([campaignId, paymentId, recipientEmail])
  @@index([campaignId, paymentId])
  @@index([campaignId, respondedAt])
}
